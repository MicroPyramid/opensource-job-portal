# Recruiter UI (Next.js) Environment Variables

# Django REST API root. Server-only — the browser never calls Django directly.
API_BASE_URL=http://localhost:8000/api/v1

# This app's public origin, used for OAuth callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Production only: S3 bucket host serving Django MEDIA_URL, for next/image.
# Matches AWS_S3_CUSTOM_DOMAIN in backend/jobsp/settings_server.py.
# MEDIA_HOSTNAME=your-bucket.s3.amazonaws.com
